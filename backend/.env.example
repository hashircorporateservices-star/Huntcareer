APP_NAME="AI Job Copilot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://copilot.yourdomain.com

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=job_copilot
DB_USERNAME=copilot
DB_PASSWORD=

# --- Redis (queue + cache) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- S3-compatible storage (resumes) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Elasticsearch (job search) ---
ELASTICSEARCH_HOST=http://127.0.0.1:9200

# --- Job sources ---
# Adzuna aggregator (free tier available): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Greenhouse public boards to search (comma-separated board tokens)
ATS_GREENHOUSE_BOARDS=

# --- AI provider (matching, tailoring, cover letters) ---
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_KEY=
AI_MODEL=gpt-4o-mini

# --- Google OAuth + Gmail read-only ingestion ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://copilot.yourdomain.com/auth/google/callback

# --- Microsoft OAuth ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://copilot.yourdomain.com/auth/microsoft/callback
MICROSOFT_TENANT=common

# --- Facebook OAuth ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://copilot.yourdomain.com/auth/facebook/callback

# Where to send the user after login (your Next.js frontend)
FRONTEND_URL=https://copilot.yourdomain.com

# --- Lemon Squeezy billing ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_SIGNING_SECRET=
# One variant ID per plan + cycle (from your Lemon Squeezy product variants)
LS_PREMIUM_WEEKLY=
LS_PREMIUM_MONTHLY=
LS_PREMIUM_QUARTERLY=
LS_ELITE_WEEKLY=
LS_ELITE_MONTHLY=
LS_ELITE_QUARTERLY=

# --- Official ATS integrations (leave disabled unless you have API access) ---
ATS_GREENHOUSE_ENABLED=false
ATS_GREENHOUSE_TOKEN=
ATS_GREENHOUSE_SUBMIT_URL=
ATS_LEVER_ENABLED=false
ATS_LEVER_TOKEN=
ATS_LEVER_SUBMIT_URL=

# --- Frontend origin (for Sanctum SPA auth) ---
SANCTUM_STATEFUL_DOMAINS=copilot.yourdomain.com
SESSION_DOMAIN=.yourdomain.com
